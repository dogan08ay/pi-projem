{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/approve.js": {
      "maxDuration": 60
    },
    "api/config.js": {
      "maxDuration": 10
    },
    "api/telegram-webhook.js": {
      "maxDuration": 10
    },
    "api/cron-daily-digest.js": {
      "maxDuration": 10
    },
    "api/csp-report.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily-digest",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.minepi.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://storage.googleapis.com https://api.qrserver.com; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://firestore.googleapis.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://sdk.minepi.com https://*.minepi.com wss://*.minepi.com; frame-src 'self' https://*.minepi.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self' https://*.minepi.com; base-uri 'self'; object-src 'none'; form-action 'self'; report-uri /api/csp-report"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
